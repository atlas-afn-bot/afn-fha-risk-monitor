{
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/upload-sas",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["POST"]
    },
    {
      "route": "/api/list-recent-uploads",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["GET"]
    },
    {
      "_comment": "Read-only files API for RPA (Michael Kunisaki's team). Auth is API-key-only (X-API-Key header), enforced inside the Function.",
      "route": "/api/files/*",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["GET", "POST"]
    },
    {
      "route": "/api/files",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["GET"]
    },
    {
      "route": "/uploads",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.ico",
      "/*.png",
      "/*.svg"
    ]
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
