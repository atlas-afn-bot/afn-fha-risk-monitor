{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/18a2c300-b493-4837-a293-015508c28170/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/upload-sas",
      "allowedRoles": ["authenticated"],
      "methods": ["POST"]
    },
    {
      "route": "/api/list-recent-uploads",
      "allowedRoles": ["authenticated"],
      "methods": ["GET"]
    },
    {
      "_comment": "Read-only files API for RPA (Michael Kunisaki's team). Auth is API-key-only (X-API-Key header), enforced inside the Function. Must be anonymous at the SWA layer so RPA isn't redirected to Entra SSO.",
      "route": "/api/files/*",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["GET", "POST"]
    },
    {
      "route": "/api/files",
      "allowedRoles": ["anonymous", "authenticated"],
      "methods": ["GET"]
    },
    {
      "route": "/uploads",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.ico",
      "/*.png",
      "/*.svg"
    ]
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
